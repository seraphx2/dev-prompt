# One-click install descriptor: adds the dev-prompt remote (as "dev-prompt")
# and installs the app in a single step —
#
#   flatpak install --user \
#     https://seraphx2.github.io/dev-prompt/io.github.seraphx2.devprompt.flatpakref
#
# Published verbatim at
# https://seraphx2.github.io/dev-prompt/io.github.seraphx2.devprompt.flatpakref
# (copied there by packaging/repo/build-repo.sh).
#
# RuntimeRepo points at Flathub so the GNOME 50 runtime resolves automatically
# for users who don't already have it. GPGKey: see dev-prompt.flatpakrepo.
[Flatpak Ref]
Name=io.github.seraphx2.devprompt
Branch=stable
Title=dev-prompt
Url=https://seraphx2.github.io/dev-prompt/flatpak
Homepage=https://github.com/seraphx2/dev-prompt
Comment=Command-palette overlay for launching dev repositories
Icon=https://raw.githubusercontent.com/seraphx2/dev-prompt/main/src-tauri/icons/128x128.png
IsRuntime=false
SuggestRemoteName=dev-prompt
RuntimeRepo=https://dl.flathub.org/repo/flathub.flatpakrepo

