# Maintainer: seraphx2 <seraphx2@live.com>
#
# AUR package: dev-prompt  (builds from a release tag)
# For the no-compile variant see PKGBUILD-bin.
#
# The release workflow overwrites `pkgver` and `sha256sums` before pushing to
# the AUR (see docs/linux-distribution/phase-2-aur.md). To build against the
# working tree locally instead:
#   makepkg -f  --  after pointing `source` at a local checkout, or just use
#   `npm run tauri build` directly.

pkgname=dev-prompt
pkgver=0.0.0
pkgrel=1
pkgdesc="Command-palette overlay for launching dev repositories"
arch=('x86_64')
url="https://github.com/seraphx2/dev-prompt"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'libayatana-appindicator'
         'hicolor-icon-theme')
makedepends=('rust' 'npm' 'nodejs' 'git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export npm_config_cache="$srcdir/npm-cache"
  npm ci
  # --no-bundle: we only want the binary; -c: skip updater signing.
  npm run tauri build -- --no-bundle -c '{"bundle":{"createUpdaterArtifacts":false}}'
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 src-tauri/target/release/dev-prompt \
    "$pkgdir/usr/bin/dev-prompt"

  install -Dm644 packaging/linux/dev-prompt.desktop \
    "$pkgdir/usr/share/applications/dev-prompt.desktop"
  install -Dm644 packaging/linux/io.github.seraphx2.devprompt.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.seraphx2.devprompt.metainfo.xml"

  install -Dm644 src-tauri/icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/dev-prompt.png"
  install -Dm644 src-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/dev-prompt.png"
  install -Dm644 src-tauri/icons/128x128@2x.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/dev-prompt.png"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
