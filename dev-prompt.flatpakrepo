# Repo descriptor for the self-hosted dev-prompt Flatpak remote.
# Published verbatim at https://seraphx2.github.io/dev-prompt/dev-prompt.flatpakrepo
# (copied there by packaging/repo/build-repo.sh).
#
#   flatpak remote-add --if-not-exists --user dev-prompt \
#     https://seraphx2.github.io/dev-prompt/dev-prompt.flatpakrepo
#
# GPGKey is base64 of the *binary* (de-armored) repo signing public key — the
# same key that signs the apt/rpm/pacman metadata (id E3C07CD21A9A9BA5,
# packaging/repo/dev-prompt-repo.asc). Regenerate on a key rotation with:
#   gpg --dearmor < packaging/repo/dev-prompt-repo.asc | base64 -w0
[Flatpak Repo]
Title=dev-prompt
Url=https://seraphx2.github.io/dev-prompt/flatpak
Homepage=https://github.com/seraphx2/dev-prompt
Comment=Command-palette overlay for launching dev repositories
Description=Self-hosted Flatpak repository for dev-prompt.
Icon=https://raw.githubusercontent.com/seraphx2/dev-prompt/main/src-tauri/icons/128x128.png
DefaultBranch=stable

