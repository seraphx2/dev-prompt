# Maintainer: seraphx2 <seraphx2@live.com>
#
# AUR package: dev-prompt-bin  (repackages the release .deb — no compile)
#
# The release workflow overwrites `pkgver` and `sha256sums` before pushing to
# the AUR (see docs/linux-distribution/phase-2-aur.md).
#
# The .deb already carries the desktop file, hicolor icons, and the AppStream
# metainfo (wired in via bundle.linux.deb.files in src-tauri/tauri.linux.conf.json),
# so package() is just an extraction.

pkgname=dev-prompt-bin
_pkgname=dev-prompt
pkgver=0.0.0
pkgrel=1
pkgdesc="Command-palette overlay for launching dev repositories"
arch=('x86_64')
url="https://github.com/seraphx2/dev-prompt"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'libayatana-appindicator'
         'hicolor-icon-theme')
provides=('dev-prompt')
conflicts=('dev-prompt')
source=("$url/releases/download/v$pkgver/${_pkgname}_${pkgver}_amd64.deb")
sha256sums=('SKIP')

package() {
  # A .deb is an `ar` archive; its payload is data.tar.*
  bsdtar -xf "${_pkgname}_${pkgver}_amd64.deb" -C "$srcdir"
  bsdtar -xf "$srcdir"/data.tar.* -C "$pkgdir"

  # Tauri's .deb installs the binary at /usr/bin and icons under hicolor; nothing
  # to relocate. Just drop the license in the conventional place if absent.
  if [ ! -e "$pkgdir/usr/share/licenses/$_pkgname/LICENSE" ]; then
    install -dm755 "$pkgdir/usr/share/licenses/$_pkgname"
    printf 'See %s\n' "$url/blob/v$pkgver/LICENSE" \
      > "$pkgdir/usr/share/licenses/$_pkgname/LICENSE"
  fi
}
